# Target: bench hardware is ESP32-S3-WROOM-1 N8R8 (8 MB flash, 8 MB octal PSRAM), but flash/
# PSRAM below are deliberately budgeted against a smaller candidate SKU (N4R2, 4 MB flash / 2 MB
# quad PSRAM) to right-size the final BOM part.
CONFIG_IDF_TARGET="esp32s3"

# Capped to 4 MB (the N4R2 candidate's size) rather than the N8R8 dev board's actual 8 MB --
# safe to test on this hardware, since configuring smaller than the physical chip just leaves
# the rest unused, not a functional risk. App binary is ~1.3 MB; the custom table (partitions.csv)
# gives it a 3 MB slot, comfortably under 4 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Needed to buffer captured utterances and TTS audio, which are too large for the ~290 KB of
# internal DRAM left after WiFi. heap_caps_malloc(MALLOC_CAP_SPIRAM).
#
# MODE_QUAD matches the production board/billy PCB's N4R2 module (quad PSRAM) -- octal and quad
# are different chips/SPI protocols, not a size setting, so this build will fail PSRAM init on
# the bench N8R8's octal-wired PSRAM. Switch back to MODE_OCT when building for the N8R8 dev
# board.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
