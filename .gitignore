# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Planning artifacts/docs
.devdocs/

# Build artifacts (cmake, ESP-IDF, etc.) -- no trailing slash: these may be plain
# directories or symlinks onto local storage (see src/firmware/clean.sh), and a trailing
# slash only matches the former.
build
.cache

# Sample schematics
board/tmp/

# KiCad per-user/local state and backups -- not design data
*.kicad_prl
*.bak
~*.lck
.history/

# ESP-IDF generated (keep sdkconfig.defaults; the rest is per-machine / fetched)
sdkconfig
sdkconfig.old
managed_components
dependencies.lock

# macOS
.DS_Store
# AppleDouble sidecar files (resource-fork/xattr metadata on non-native volumes)
._*
